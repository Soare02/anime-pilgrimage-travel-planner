# 前端密钥 — 用户在网页"AI 设置"中自行输入，无需在此填写
VITE_ARK_API_KEY=
VITE_ARK_MODEL=

# 后端密钥 — 仅在运行 server.py / agent.py 时需要
# 独立管理后台 /admin/；账号或密码未配置时拒绝所有管理数据访问
# 密码至少 12 位，仅后端读取，禁止使用 VITE_ 前缀
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 会话有效期，默认 8 小时（范围 300–86400 秒）；后端重启后需重新登录
ADMIN_SESSION_TTL_SECONDS=28800
# 本地 HTTP 开发为 0，生产环境 HTTPS 部署必须设为 1
ADMIN_COOKIE_SECURE=0

DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Agent 文本模型名称；修改后重启 Python 后端
AGENT_MODEL=deepseek-v4-flash
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_INCLUDE_DOMAINS=anitabi.cn,bgm.tv,bangumi.tv,animetourism88.com,anime-tourism.jp,seichimap.jp,ja.wikipedia.org,zh.wikipedia.org,japan-guide.com
TAVILY_EXCLUDE_DOMAINS=github.com,huggingface.co,kaggle.com,medium.com,csdn.net,jianshu.com

# 新版 RAG：Tavily 失败/资料不足时依次直接搜索，补够后停止；无 Tavily Key 也可兜底
RAG_ENABLE_DIRECT_FALLBACK=1
RAG_DIRECT_SEARCH_ENGINES=baidu,bing,ddg
RAG_DIRECT_MAX_QUERIES=2
RAG_DIRECT_MAX_PAGES=2
# 批量联网总预算及其中 Tavily 阶段预算（秒），给备用引擎预留时间
RAG_WEB_TIMEOUT_SECONDS=30
RAG_TAVILY_PHASE_TIMEOUT_SECONDS=12

# MiMo 视觉模型 — 仅 Agent 模式中分析动漫截图时使用
MIMO_API_KEY=your_mimo_api_key_here
MIMO_MODEL=mimo-v2.5
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Agent v2 规模、修复次数与调用时限（单位：秒）
AGENT_MAX_LANDMARKS=50
AGENT_MAX_DAYS=30
AGENT_MAX_REVISIONS=3
AGENT_MODEL_TIMEOUT_SECONDS=45
AGENT_TOOL_TIMEOUT_SECONDS=35
AGENT_RUN_TIMEOUT_SECONDS=240

# RAG 向量集合绑定配置；更换模型或维度时使用独立版本索引，不混写旧集合
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_DIMENSION=1024
EMBEDDING_CONFIG_VERSION=1
EMBEDDING_TIMEOUT_SECONDS=5
